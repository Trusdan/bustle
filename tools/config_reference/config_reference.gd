## The headless side of [code]tools/config_reference.sh[/code]: writes the configuration reference
## for every [code]@export[/code] field in [code]addons/bustle/[/code] and every
## [code]bustle/...[/code] project setting. After [code]--[/code]: [code]<ranges.tsv> <out.md>[/code].
## [br][br]
## Type and effect come from the source (the declared type and the [code]##[/code] comment above
## the field), the default from a fresh instance, and the range from the field's own export hint or,
## for a number with no hint, the hand-checked entry in the ranges file. Exits 1 when a number has
## no range entry, an entry names no field, or a script fails to load.

const ROOT := "res://addons/bustle"
const HEADER := "Generated by `tools/config_reference.sh` from the code and `tools/config_reference/ranges.tsv`. Do not edit by hand."

var _problems: PackedStringArray = []


func _init() -> void:
	var args: PackedStringArray = OS.get_cmdline_user_args()
	if args.size() != 2:
		printerr("usage: <ranges.tsv> <out.md>")
		quit(2)
		return
	var ranges := _read_ranges(args[0])
	var used: Dictionary[String, bool] = {}
	var sections: PackedStringArray = []
	var settings: PackedStringArray = []
	var count := 0
	var paths := _scripts(ROOT)
	paths.sort()
	var classes: Array[Dictionary] = []
	for path: String in paths:
		var source := FileAccess.get_file_as_string(path)
		settings.append_array(_settings(source))
		if not RegEx.create_from_string("(?m)^@export").search(source):
			continue
		classes.append(_class(path, source, ranges, used))
	classes.sort_custom(func(a: Dictionary, b: Dictionary) -> bool: return a["name"] < b["name"])
	for entry: Dictionary in classes:
		sections.append(entry["text"])
		count += int(entry["fields"])
	for key: String in ranges:
		if not used.has(key):
			_problems.append("ranges.tsv names %s, which is not a number field" % key)
	settings.sort()
	var out: PackedStringArray = [
		"# Configuration reference", "", HEADER, "",
		"Every `@export` field a host can set (%d fields in %d classes) and every project setting Bustle reads. **Default** is the value of a fresh instance. **Range** comes from the field's editor hint where it has one, and otherwise was checked by hand against the code: *checked* means the class's validation refuses a value outside it, *clamped* means the code clamps the value into it, and *unchecked* means the code uses the value as given, so the range is where it makes sense. A dash means the field has no numeric range; its **Effect** says what it takes. The review of each default is in [defaults-review.md](defaults-review.md)." % [count, classes.size()], "",
		"## Project settings", "",
		"| Setting | Type | Default | Effect |", "| --- | --- | --- | --- |",
	]
	out.append_array(settings)
	out.append("")
	for text: String in sections:
		out.append(text)
	if not _problems.is_empty():
		for problem: String in _problems:
			printerr(problem)
		quit(1)
		return
	var file := FileAccess.open(args[1], FileAccess.WRITE)
	file.store_string("\n".join(out).strip_edges() + "\n")
	file.close()
	quit(0)


func _scripts(dir: String) -> PackedStringArray:
	var out: PackedStringArray = []
	for sub: String in DirAccess.get_directories_at(dir):
		out.append_array(_scripts(dir.path_join(sub)))
	for file: String in DirAccess.get_files_at(dir):
		if file.get_extension() == "gd":
			out.append(dir.path_join(file))
	return out


func _read_ranges(path: String) -> Dictionary[String, String]:
	var out: Dictionary[String, String] = {}
	for line: String in FileAccess.get_file_as_string(path).split("\n"):
		if line.strip_edges() == "" or line.begins_with("#"):
			continue
		var parts := line.split("\t", false, 1)
		if parts.size() != 2:
			_problems.append("ranges.tsv: not a <Class.field> TAB <range> line: " + line)
			continue
		if out.has(parts[0]):
			_problems.append("ranges.tsv names %s twice" % parts[0])
		out[parts[0]] = parts[1].strip_edges()
	return out


## One class: its heading, its brief and a row per field.
func _class(path: String, source: String, ranges: Dictionary[String, String], used: Dictionary[String, bool]) -> Dictionary:
	var name_match := RegEx.create_from_string("(?m)^class_name (\\w+)").search(source)
	var name := name_match.get_string(1) if name_match else path.get_file()
	var script: Script = load(path)
	var instance: Object = null
	if script == null or not script.can_instantiate():
		_problems.append("%s: can't load or instantiate it" % path)
	else:
		instance = script.new()
	var hints: Dictionary[String, Dictionary] = {}
	if instance != null:
		for property: Dictionary in instance.get_property_list():
			hints[String(property["name"])] = property
	var lines := source.split("\n")
	var rows: PackedStringArray = []
	var field := RegEx.create_from_string("^@export\\w*(?:\\([^)]*\\))? var (\\w+)\\s*(?::\\s*([^=]*?))?\\s*(?::?=\\s*(.*))?$")
	for i in lines.size():
		var m := field.search(lines[i])
		if m == null:
			continue
		var field_name := m.get_string(1)
		var declared := m.get_string(2).strip_edges()
		var value: Variant = instance.get(field_name) if instance != null else null
		if declared == "":
			declared = type_string(typeof(value))
		var key := "%s.%s" % [name, field_name]
		var hint: Dictionary = hints.get(field_name, {})
		var range_text := _range(declared, hint, _enum_prefix(declared))
		if ranges.has(key):
			used[key] = true
			range_text = ranges[key]
		elif range_text == "" and _numeric(declared):
			_problems.append("ranges.tsv has no range for %s (%s)" % [key, declared])
		rows.append("| `%s` | %s | %s | %s | %s |" % [field_name, _cell("`%s`" % declared),
				_cell(_value(value, hint, _enum_prefix(declared))), _cell(range_text if range_text != "" else "—"), _cell(_md(_doc(lines, i)))])
	if instance is Node:
		instance.free()
	var text: PackedStringArray = ["## %s" % name, "", "`%s`" % path.trim_prefix("res://addons/"), ""]
	var brief := _class_doc(lines)
	if brief != "":
		text.append_array([_md(brief), ""])
	text.append_array(["| Field | Type | Default | Range | Effect |", "| --- | --- | --- | --- | --- |"])
	text.append_array(rows)
	text.append("")
	return {"name": name, "text": "\n".join(text), "fields": rows.size()}


static func _numeric(declared: String) -> bool:
	return declared in ["int", "float"] or declared.ends_with(", float]") or declared.ends_with(", int]") \
			or declared in ["Array[float]", "Array[int]", "PackedFloat32Array", "PackedInt32Array"]


## The range an export hint states, or "" when it states none.
static func _range(declared: String, hint: Dictionary, prefix: String) -> String:
	if declared == "bool":
		return "true or false"
	match int(hint.get("hint", PROPERTY_HINT_NONE)):
		PROPERTY_HINT_RANGE:
			var parts := String(hint["hint_string"]).split(",")
			return "%s to %s" % [parts[0], parts[1]] if parts.size() >= 2 else ""
		PROPERTY_HINT_ENUM:
			var names: PackedStringArray = []
			for option: String in String(hint["hint_string"]).split(","):
				names.append("`%s%s`" % [prefix, _constant(option.get_slice(":", 0))])
			return "one of " + ", ".join(names)
		PROPERTY_HINT_LAYERS_3D_PHYSICS:
			return "3D physics layer bits"
	return ""


## The project settings a script declares, as table rows: a const holding "bustle/..." and the
## default its ProjectSettings.get_setting() call passes.
func _settings(source: String) -> PackedStringArray:
	var out: PackedStringArray = []
	var lines := source.split("\n")
	var decl := RegEx.create_from_string("^const (\\w+)\\s*:?=\\s*\"(bustle/[\\w/]+)\"")
	for i in lines.size():
		var m := decl.search(lines[i])
		if m == null:
			continue
		var call := RegEx.create_from_string("ProjectSettings\\.get_setting\\(%s,\\s*([^)]+)\\)" % m.get_string(1)).search(source)
		if call == null:
			_problems.append("%s is declared but never read with a default" % m.get_string(2))
			continue
		var default := call.get_string(1).strip_edges()
		var type := "bool" if default in ["true", "false"] else type_string(typeof(str_to_var(default)))
		out.append("| `%s` | `%s` | %s | %s |" % [m.get_string(2), type, _cell("`%s`" % default), _cell(_md(_doc(lines, i)))])
	return out


## The ## lines right above line [param at], joined.
static func _doc(lines: PackedStringArray, at: int) -> String:
	var parts: PackedStringArray = []
	var i := at - 1
	while i >= 0 and lines[i].begins_with("##"):
		parts.insert(0, lines[i].trim_prefix("##").strip_edges())
		i -= 1
	return " ".join(parts).replace(" [br] ", " [br]")


## The class's own ## comment: the first block after the extends line, up to its first paragraph break.
static func _class_doc(lines: PackedStringArray) -> String:
	var parts: PackedStringArray = []
	var started := false
	for line: String in lines:
		if not started:
			started = line.begins_with("extends ")
			continue
		if line.begins_with("##"):
			var text := line.trim_prefix("##").strip_edges()
			if text.begins_with("[br]"):
				break
			parts.append(text)
		elif not parts.is_empty() or (line != "" and not line.begins_with("##")):
			break
	return " ".join(parts)


## An enum type's prefix for its constants: "OnFail." for OnFail, "Disposition." for
## BustleDispositionPort.Disposition.
static func _enum_prefix(declared: String) -> String:
	return declared.get_slice(".", declared.get_slice_count(".") - 1) + "."


## An editor enum name ("Lash Out") back to its constant (LASH_OUT).
static func _constant(name: String) -> String:
	return name.strip_edges().to_upper().replace(" ", "_")


static func _value(value: Variant, hint: Dictionary, prefix: String) -> String:
	if int(hint.get("hint", PROPERTY_HINT_NONE)) == PROPERTY_HINT_ENUM and typeof(value) == TYPE_INT:
		var options := String(hint["hint_string"]).split(",")
		for i in options.size():
			var parts := options[i].split(":")
			if (int(parts[1]) if parts.size() > 1 else i) == value:
				return "`%s%s`" % [prefix, _constant(parts[0])]
	return "`%s`" % _plain(value)


static func _plain(value: Variant) -> String:
	match typeof(value):
		TYPE_NIL:
			return "null"
		TYPE_STRING_NAME:
			return "&\"%s\"" % value
		TYPE_STRING:
			return "\"%s\"" % value
		TYPE_FLOAT:
			if is_nan(value):
				return "NAN"
			var text := str(value)
			return text if text.contains(".") or text.contains("e") or text.contains("inf") or text.contains("nan") else text + ".0"
		TYPE_ARRAY:
			var items: PackedStringArray = []
			for item: Variant in value:
				items.append(_plain(item))
			return "[%s]" % ", ".join(items)
		TYPE_DICTIONARY:
			var pairs: PackedStringArray = []
			for key: Variant in value:
				pairs.append("%s: %s" % [_plain(key), _plain(value[key])])
			return "{%s}" % ", ".join(pairs)
		TYPE_OBJECT:
			if value == null:
				return "null"
			var script: Script = value.get_script()
			var kind: String = script.get_global_name() if script != null and script.get_global_name() != "" else value.get_class()
			var id: Variant = value.get(&"id") if &"id" in value else null
			return "%s(%s)" % [kind, _plain(id)] if id != null else "a %s" % kind
	return var_to_str(value)


static func _md(text: String) -> String:
	var out := text.replace("[br]", " ").replace("[b]", "**").replace("[/b]", "**").replace("[i]", "*").replace("[/i]", "*")
	out = RegEx.create_from_string("\\[code\\]([\\s\\S]*?)\\[/code\\]").sub(out, "`$1`", true)
	out = RegEx.create_from_string("\\[method ([\\w.]+)\\]").sub(out, "`$1()`", true)
	out = RegEx.create_from_string("\\[(?:param|member|constant|signal|enum) ([\\w.]+)\\]").sub(out, "`$1`", true)
	out = RegEx.create_from_string("\\[([A-Z]\\w*)\\]").sub(out, "`$1`", true)
	while out.contains("  "):
		out = out.replace("  ", " ")
	return out.strip_edges()


static func _cell(text: String) -> String:
	return text.replace("|", "\\|").replace("\n", " ")
